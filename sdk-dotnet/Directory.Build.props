<Project>

  <PropertyGroup>
    <!-- Sprint D1 targets net8.0 LTS (out-of-support Nov 2026). A follow-up
         sprint adds net10.0 LTS (the current default for new builds in
         2026) once the package metadata for the multi-target build is
         settled. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- CA1032: standard exception constructors (parameterless, message-only,
         message+inner) are intentionally omitted — every HfcxException MUST
         carry a wire-format code, and every typed subclass pins its code in
         the only public constructor. The platform's wire-format guarantees
         depend on this; the standard pattern would let callers construct
         exceptions without a code. -->
    <!-- CA1716: 'Operation' / 'Tier' / etc. are not language keywords in C#
         and the cross-SDK invariant requires these names. -->
    <!-- CA1819: arrays as properties — unused in D1; safe to enable later. -->
    <!-- CS1591: missing XML doc comments — overlaid with explicit docs on
         the public surface; suppressed for internals. -->
    <NoWarn>$(NoWarn);CA1032;CA1716;CS1591</NoWarn>

    <!-- Cross-SDK invariant: SDK 1.x targets platform 1.x. Bumped via the
         fhir-ig/sync.sh helper in lockstep with PLATFORM_VERSION. -->
    <Authors>HealthFlow Medical HCX</Authors>
    <Company>HealthFlow Medical HCX</Company>
    <Copyright>Copyright (c) HealthFlow Medical HCX. Licensed under Apache 2.0.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HealthFlow-Medical-HCX/hfcx_sdks_2026</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HealthFlow-Medical-HCX/hfcx_sdks_2026</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Bump in lockstep with sdk-java/hfcx-sdk-core/pom.xml's <version>
         and sdk-python/pyproject.toml's project.version. Cross-SDK
         invariant. Sprint D1 ships an alpha that lines up with the Java
         and Python 1.0.0-SNAPSHOT / 0.1.0a0 lines. -->
    <Version>0.1.0-alpha.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <InformationalVersion>0.1.0-alpha.0</InformationalVersion>
  </PropertyGroup>

</Project>
