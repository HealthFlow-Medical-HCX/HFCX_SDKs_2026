<Project>
  <!-- Override the SDK's strict analysis for the example. The example app
       is illustrative; it doesn't ship as a NuGet package. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);CA1062;CA1303;CA1812;CA2007;CA1816;CA1859;CS1591</NoWarn>
  </PropertyGroup>
</Project>
