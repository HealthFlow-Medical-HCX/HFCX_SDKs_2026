root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java + Kotlin: 4 spaces is the platform-wide default.
[*.{java,kt,kts}]
indent_size = 4
max_line_length = 120

# Python (forward-looking, sdk-python/): PEP 8.
[*.py]
indent_size = 4
max_line_length = 100

# JavaScript / TypeScript (forward-looking, sdk-javascript/): 2 spaces is
# the npm-ecosystem norm.
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# C# (forward-looking, sdk-dotnet/).
[*.{cs,csproj}]
indent_size = 4

# Markup and config.
[*.{xml,pom,yml,yaml,json,toml,html,svg}]
indent_size = 2

# Markdown: trailing spaces are sometimes meaningful (line break).
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Makefiles must use real tabs.
[{Makefile,*.mk}]
indent_style = tab
