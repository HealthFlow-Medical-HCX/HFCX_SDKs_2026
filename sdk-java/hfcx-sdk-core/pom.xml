<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eg.gov.healthflow</groupId>
        <artifactId>hfcx-sdk-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>hfcx-sdk-core</artifactId>
    <packaging>jar</packaging>

    <name>HFCX SDK for Java :: core</name>
    <description>
        Protocol primitives extracted from the hfcx-platform repo: JWE
        encryption (RSA-OAEP-256 + A256GCM), FHIR R4 validation against
        the Egyptian IG, and Egyptian field validators (National ID,
        phone, IBAN, governorate). This module is consumed by
        hfcx-sdk-client and, after extraction lands, by the platform's
        hcx-apis module.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Filter version.properties at build time so HfcxSdkVersion picks
          up project.version (from this pom) and platform.version (from
          the parent pom; updated in lockstep with fhir-ig/PLATFORM_VERSION
          by fhir-ig/sync.sh) instead of hardcoded literals drifting from
          the build.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
