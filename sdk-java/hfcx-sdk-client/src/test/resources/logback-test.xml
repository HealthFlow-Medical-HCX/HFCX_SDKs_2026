<?xml version="1.0" encoding="UTF-8"?>
<!--
    Test-only logback config. Quiet by default to keep test output clean;
    individual tests programmatically attach a ListAppender to the SDK
    loggers when they need to assert log content.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} cid=%X{correlationId:--} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="com.github.tomakehurst.wiremock" level="WARN"/>
    <logger name="eg.gov.healthflow" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
